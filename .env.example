# Minus AI Agent Platform - Environment Variables
# Copy this file to .env and fill in your values.

# === LLM Provider Keys (SaaS mode, server-side) ===
# When set, these take priority over client-side keys.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxx

# === Tool API Keys ===

# Tavily API Key (web search tool)
# Get one at: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxx

# E2B API Key (code execution sandbox, optional)
# Get one at: https://e2b.dev
# Falls back to local execution (node/python) if not set
# E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxxx

# Workspace directory for file_manager tool
# Defaults to process.cwd() if not set
# MINUS_WORKSPACE=/path/to/workspace
